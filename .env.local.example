# ─────────────────────────────────────────────
# VS Electricals — Environment variables
# Copy this file to ".env.local" and fill in your
# MySQL credentials, then restart the dev server.
# ─────────────────────────────────────────────

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=111978697
DB_NAME=vs_electricals

# TLS (required for hosted providers such as Aiven)
# Download/copy the CA certificate from the provider and paste its complete PEM
# value here. On Vercel, create this as a Secret environment variable.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Keep certificate verification enabled in production. Set to false only as a
# temporary diagnostic step when a provider requires encryption but no CA is set.
DB_SSL_REJECT_UNAUTHORIZED=true

# Public site info (optional)
NEXT_PUBLIC_SITE_NAME=VS Electricals
NEXT_PUBLIC_WHATSAPP=91796979769
NEXT_PUBLIC_PHONE=+91 78577575979
NEXT_PUBLIC_EMAIL=vinodent78996@gmail.com
